# Normalise line endings. Without this, files written on Windows (CRLF) and
# checked out on Colab's Linux VM (LF) show as modified on both sides, and
# shell scripts checked out with CRLF fail to execute on Linux.
* text=auto eol=lf

# Binary: never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.pt  binary
*.pth binary
*.ckpt binary
*.mdb binary
*.lmdb binary
